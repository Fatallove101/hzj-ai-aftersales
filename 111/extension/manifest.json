{
  "manifest_version": 3,
  "name": "跨境售后 AI 话术助手",
  "version": "0.24.2",
  "description": "在客服后台侧边栏读取对话，生成候选话术并一键插入输入框。配合本地服务 (127.0.0.1:8799) 使用。",

  "permissions": ["storage", "activeTab", "scripting"],

  "host_permissions": [
    "http://127.0.0.1:8799/*",
    "http://localhost:8799/*",
    "https://*.tiktok.com/*",
    "https://*.tiktokglobalshop.com/*",
    "https://sellercentral.amazon.com/*",
    "https://sellercentral-europe.amazon.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "commands": {
    "open-workbench": {
      "suggested_key": { "default": "Alt+Shift+W" },
      "description": "在独立小窗打开话术助手（不受页面 CSP 限制，任何平台都能用）"
    }
  },

  "action": {
    "default_title": "跨境售后 AI 话术助手（点击开/关侧边栏）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "https://*.tiktok.com/*",
        "https://*.tiktokglobalshop.com/*",
        "https://sellercentral.amazon.com/*",
        "https://sellercentral-europe.amazon.com/*"
      ],
      "js": [
        "lib/util.js",
        "lib/extract.js",
        "lib/picker.js",
        "adapters/index.js",
        "adapters/tiktok_shop.js",
        "adapters/amazon.js",
        "adapters/generic.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
